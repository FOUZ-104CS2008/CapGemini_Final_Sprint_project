<?xml version="1.0" encoding="UTF-8"?>


<suite name="DemoWebShop Cross Browser Suite">

    <!-- CHROME: 18 test cases -->
    <test name="Chrome - All Modules">
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="testcases.RegistrationTest"/>
            <class name="testcases.LoginTest"/>
            <class name="testcases.ShoppingCartTest"/>
